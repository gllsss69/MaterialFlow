<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MaterialFlow.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MaterialFlow/Resources/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://MaterialFlow/Resources/Styles/Components.axaml"/>
                <ResourceInclude Source="avares://MaterialFlow/Resources/Langs/en.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Light" PrimaryColor="Purple" SecondaryColor="Indigo" />
        <materialIcons:MaterialIconStyles />
    </Application.Styles>

</Application>