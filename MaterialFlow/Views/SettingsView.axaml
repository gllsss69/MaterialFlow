<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:vm="using:MaterialFlow.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MaterialFlow.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*" Margin="32">
        <!-- Centered Settings Header -->
        <Border Grid.Row="0" HorizontalAlignment="Center" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="32" Padding="48,16" Margin="0,0,0,48">
            <TextBlock Text="{DynamicResource HeaderSettings}" FontSize="32" FontWeight="Normal" Foreground="{DynamicResource OnSurfaceBrush}"/>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto" 
                      Theme="{StaticResource MaterialModernScrollViewer}">
            <StackPanel Spacing="32" MaxWidth="600" HorizontalAlignment="Left">
                <!-- Language -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource HeaderLanguage}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                              Width="400"
                              assists:ComboBoxAssist.Label="{DynamicResource LabelSelectLanguage}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"/>
                </StackPanel>

                <!-- Theme -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource HeaderTheme}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                              Width="400"
                              assists:ComboBoxAssist.Label="{DynamicResource LabelSelectTheme}"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"/>
                </StackPanel>

                <!-- Save Path -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource HeaderSavePath}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    <Grid ColumnDefinitions="*,Auto" Width="550">
                        <TextBox Theme="{StaticResource MaterialOutlineTextBox}"
                                 assists:TextFieldAssist.Label="{DynamicResource LabelPathForProjects}"
                                 Classes="outline"
                                 Background="Transparent"
                                 UseFloatingPlaceholder="True"
                                 IsReadOnly="True"
                                 Text="{Binding DefaultSavePath}"/>
                        <Button Grid.Column="1" 
                                Theme="{StaticResource MaterialFlatButton}" 
                                Width="48" Height="48" 
                                Margin="8,4,0,0"
                                Padding="0"
                                Click="SelectDefaultPath_Click">
                            <material:MaterialIcon Kind="FolderEdit" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Enable Project Logging -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{DynamicResource LabelEnableLogging}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding EnableProjectLogging}" Theme="{StaticResource MaterialCheckBox}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- FFmpeg Status -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource HeaderFFmpegStatus}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="16" Padding="24" Width="550">
                        <StackPanel Spacing="12">
                            <!-- Status indicator row -->
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <!-- Green circle when available -->
                                <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                         IsVisible="{Binding IsFFmpegAvailable}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#4CAF50"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Red circle when not available -->
                                <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                         IsVisible="{Binding !IsFFmpegAvailable}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#F44336"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{DynamicResource LabelFFmpegStatusPrefix}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{Binding FFmpegStatusText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Version string -->
                            <TextBlock Text="{Binding FFmpegVersionText}" TextWrapping="Wrap"
                                       FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       IsVisible="{Binding IsFFmpegAvailable}"/>
                            <!-- Refresh button -->
                            <Button Theme="{StaticResource MaterialFlatButton}" 
                                    Foreground="{DynamicResource PrimaryBrush}" 
                                    Background="Transparent" 
                                    HorizontalAlignment="Left" 
                                    Margin="-16,4,0,0"
                                    CornerRadius="16"
                                    Click="RefreshFFmpegStatus_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Refresh" Width="20" Height="20"/>
                                    <TextBlock Text="{DynamicResource BtnRefreshStatus}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="12" Margin="0,32,0,0">
                    <TextBlock Text="{DynamicResource HeaderAbout}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="16" Padding="24" Width="550">
                        <StackPanel Spacing="16">
                            <TextBlock Text="MaterialFlow" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <TextBlock Text="{DynamicResource TextAppVersion}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                            <TextBlock Text="{DynamicResource TextAboutDescription}" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Button Theme="{StaticResource MaterialFlatButton}" Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" HorizontalAlignment="Left" Margin="-16,8,0,0" Click="OpenGitHub_Click" CornerRadius="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Github" Width="20" Height="20"/>
                                    <TextBlock Text="{DynamicResource BtnViewGitHub}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
