<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaterialFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:conv="using:MaterialFlow.Converters"
        xmlns:views="using:MaterialFlow.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MaterialFlow.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MaterialFlow"
        Background="{DynamicResource WindowBackgroundBrush}"
        MinWidth="1200" MinHeight="700">

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityConverter"/>
        <conv:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.Capsule">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Dark Purple Button (Primary) -->
        <Style Selector="Button.PrimaryCapsule">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.PrimaryCapsule:pointerover /template/ Border#PART_RootBorder">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.PrimaryCapsule:pressed /template/ Border#PART_RootBorder">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Light Purple Button (Secondary) -->
        <Style Selector="Button.SecondaryCapsule">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>
        <Style Selector="Button.SecondaryCapsule:pointerover /template/ Border#PART_RootBorder">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.SecondaryCapsule:pressed /template/ Border#PART_RootBorder">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Sidebar Item Style -->
        <Style Selector="ListBoxItem.SidebarItem">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter" 
                                          Content="{TemplateBinding Content}" 
                                          Padding="{TemplateBinding Padding}" 
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:selected">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="ListBoxItem.SidebarItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>

        <!-- Tab Chip Style -->
        <Style Selector="ListBoxItem.TabChip">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter" 
                                          Content="{TemplateBinding Content}" 
                                          Padding="{TemplateBinding Padding}" 
                                          VerticalContentAlignment="Center" 
                                          HorizontalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem.TabChip:selected">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Search Box Style -->
        <Style Selector="TextBox.SearchCapsule">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Disable default ListBoxItem visuals completely -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- MenuFlyout Styles -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        </Style>
        
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>

        <!-- Play overlay hover effect -->
        <Style Selector="Button:pointerover Panel#PlayOverlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*" Margin="24">

        <!-- Sidebar Panel -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}" Margin="0,0,24,0" CornerRadius="32" 
                Background="{DynamicResource SurfaceBrush}" BoxShadow="0 4 20 0 #15000000"
                ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            
            <Grid RowDefinitions="Auto,*,Auto">
                
                <!-- Brand/Logo (Only MF Square is the trigger) -->
                <StackPanel Grid.Row="0" Margin="0,32,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button Theme="{StaticResource MaterialFlatButton}" Padding="0" Click="ToggleSidebar_Click" Background="Transparent" BorderThickness="0" FocusAdorner="{x:Null}">
                            <Image Source="avares://MaterialFlow/Resources/Assets/logo.png" Width="80" Height="80"/>
                        </Button>
                        <TextBlock Text="MaterialFlow" FontWeight="Black" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}"/>
                    </StackPanel>
                    <Separator Margin="0,32,0,0" Background="{DynamicResource SurfaceVariantBrush}" Height="1" 
                               Width="{Binding DividerWidth}" HorizontalAlignment="Center">
                        <Separator.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Separator.Transitions>
                    </Separator>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="8">
                    <Button Theme="{StaticResource MaterialFlatButton}" CornerRadius="28" Background="Transparent" BorderThickness="0" Padding="0" FocusAdorner="{x:Null}"
                            Command="{Binding SetPageIndex}" CommandParameter="0"
                            HorizontalAlignment="Center">
                        <Border Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" CornerRadius="28" 
                                Classes.active="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                                HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Styles>
                                <Style Selector="Border.active">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                                </Style>
                                <Style Selector="Border:not(.active)">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Border.Styles>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <material:MaterialIcon Kind="HomeOutline" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource NavHome}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource OnSecondaryContainerBrush}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Theme="{StaticResource MaterialFlatButton}" CornerRadius="28" Background="Transparent" BorderThickness="0" Padding="0" FocusAdorner="{x:Null}"
                            Command="{Binding SetPageIndex}" CommandParameter="2"
                            HorizontalAlignment="Center" IsVisible="{Binding IsAdmin}">
                        <Border Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" CornerRadius="28" 
                                Classes.active="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=2}"
                                HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Styles>
                                <Style Selector="Border.active">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                                </Style>
                                <Style Selector="Border:not(.active)">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Border.Styles>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <material:MaterialIcon Kind="Tune" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource NavPresets}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource OnSecondaryContainerBrush}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Theme="{StaticResource MaterialFlatButton}" CornerRadius="28" Background="Transparent" BorderThickness="0" Padding="0" FocusAdorner="{x:Null}"
                            Command="{Binding SetPageIndex}" CommandParameter="3"
                            HorizontalAlignment="Center" IsVisible="{Binding IsAdmin}">
                        <Border Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" CornerRadius="28" 
                                Classes.active="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=3}"
                                HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Styles>
                                <Style Selector="Border.active">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                                </Style>
                                <Style Selector="Border:not(.active)">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Border.Styles>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <material:MaterialIcon Kind="ViewDashboardOutline" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource NavPlatforms}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource OnSecondaryContainerBrush}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Margin="0,0,0,32" Spacing="8">
                    <Button Theme="{StaticResource MaterialFlatButton}" CornerRadius="28" Background="Transparent" BorderThickness="0" Padding="0" FocusAdorner="{x:Null}"
                            Command="{Binding SetPageIndex}" CommandParameter="1"
                            HorizontalAlignment="Center">
                        <Border Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" CornerRadius="28" 
                                Classes.active="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"
                                HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Styles>
                                <Style Selector="Border.active">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                                </Style>
                                <Style Selector="Border:not(.active)">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Border.Styles>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <material:MaterialIcon Kind="SettingsOutline" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource OnSecondaryContainerBrush}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SurfaceVariantBrush}" Height="1"
                               Width="{Binding DividerWidth}" HorizontalAlignment="Center">
                        <Separator.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Separator.Transitions>
                    </Separator>

                    <Button Classes="Capsule PrimaryCapsule" HorizontalAlignment="Center" Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" Padding="0" CornerRadius="28" FocusAdorner="{x:Null}"
                            Click="Login_Click" IsVisible="{Binding IsLoggedOut}">
                        <Button.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Button.Transitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <material:MaterialIcon Kind="LogoutVariant" Width="24" Height="24" Foreground="{DynamicResource OnPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource LabelLogin}" VerticalAlignment="Center" Foreground="{DynamicResource OnPrimaryBrush}" IsVisible="{Binding !IsSidebarCollapsed}"/>
                        </StackPanel>
                    </Button>

                    <!-- Profile Section (Visible when logged in) -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsLoggedIn}">
                        <Border Background="{DynamicResource SecondaryContainerBrush}" CornerRadius="28" Padding="12" Margin="12,0" HorizontalAlignment="Center" Width="{Binding ItemWidth}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="{Binding SidebarContentAlignment}">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}" MinWidth="32">
                                    <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding UserFullName}" VerticalAlignment="Center" Foreground="{DynamicResource OnSecondaryContainerBrush}" FontWeight="SemiBold" IsVisible="{Binding !IsSidebarCollapsed}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Button Theme="{StaticResource MaterialFlatButton}" Foreground="#6750A4" HorizontalAlignment="Center" Width="{Binding ItemWidth}" Click="Logout_Click" FocusAdorner="{x:Null}" Padding="0">
                             <StackPanel Orientation="Horizontal" Spacing="12">
                                <material:MaterialIcon Kind="Logout" Width="24" Height="24"/>
                                <TextBlock Text="{DynamicResource LabelLogout}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" CornerRadius="32" Background="{DynamicResource SurfaceBrush}" BoxShadow="0 4 20 0 #15000000" ClipToBounds="True">
            <Panel>
                <!-- Home Page -->
                <Grid RowDefinitions="Auto,Auto,*,Auto" DataContext="{Binding ProjectList}" IsVisible="{Binding $parent[Window].DataContext.CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}">
                
                <!-- Top Toolbar -->
                <Grid Grid.Row="0" Margin="24,24,24,16" ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="Capsule PrimaryCapsule" Height="56" Padding="32,0" Click="CreateProject_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="Plus" Width="24" Height="24"/>
                            <TextBlock Text="{DynamicResource BtnCreateProject}" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="2" 
                              Width="400"
                              Height="56"
                              CornerRadius="28"
                              Text="{Binding SearchText, Mode=TwoWay}"
                              PlaceholderText="{DynamicResource LabelSearchPlaceholder}"
                              Background="{DynamicResource SurfaceVariantBrush}"
                              BorderThickness="0"
                              VerticalContentAlignment="Center"
                              Padding="16,0">
                        <TextBox.InnerLeftContent>
                            <material:MaterialIcon Kind="Magnify" Width="24" Height="24" Margin="20,0,12,0" Opacity="0.5"/>
                        </TextBox.InnerLeftContent>
                        <TextBox.Styles>
                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
                            </Style>
                        </TextBox.Styles>
                    </TextBox>
                </Grid>

                <!-- Filter & Sort Row -->
                <Grid Grid.Row="1" Margin="24,0,24,24" ColumnDefinitions="*,Auto">
                    <!-- Filter Tabs -->
                    <ListBox Grid.Column="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Classes="TabChip"><TextBlock Text="{DynamicResource LabelAllProjects}"/></ListBoxItem>
                        <ListBoxItem Classes="TabChip"><TextBlock Text="{DynamicResource LabelRecent}"/></ListBoxItem>
                        <ListBoxItem Classes="TabChip"><TextBlock Text="{DynamicResource LabelFavorites}"/></ListBoxItem>
                    </ListBox>

                    <!-- Filters & Sorting -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        
                        <!-- Status Filter -->
                        <Button Classes="SecondaryCapsule" Height="48" Padding="16,0" CornerRadius="24" VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="MenuItem" x:DataType="vm:FilterItem">
                                    <Setter Property="Command" Value="{Binding $parent[Window].DataContext.ProjectList.SetStatusFilterCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                                    <Setter Property="Icon">
                                        <Template>
                                            <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"/>
                                        </Template>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding StatusFilters}"/>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="FilterVariant" Width="18" Height="18" Opacity="0.8" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource LabelStatus}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{Binding SelectedStatusFilter.DisplayName}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Platform Filter -->
                        <Button Classes="SecondaryCapsule" Height="48" Padding="16,0" CornerRadius="24" VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="MenuItem" x:DataType="vm:FilterItem">
                                    <Setter Property="Command" Value="{Binding $parent[Window].DataContext.ProjectList.SetPlatformFilterCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                                    <Setter Property="Icon">
                                        <Template>
                                            <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"/>
                                        </Template>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding PlatformFilters}"/>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="MonitorDashboard" Width="18" Height="18" Opacity="0.8" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource LabelPlatform}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{Binding SelectedPlatformFilter.DisplayName}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Sorting Options -->
                        <Button Classes="SecondaryCapsule" Height="48" Padding="16,0" CornerRadius="24" VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{DynamicResource SortByNameAsc}" Command="{Binding SetSortOption}" CommandParameter="NameAsc">
                                        <MenuItem.Icon>
                                            <material:MaterialIcon Kind="SortAlphabeticalAscending" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource SortByNameDesc}" Command="{Binding SetSortOption}" CommandParameter="NameDesc">
                                        <MenuItem.Icon>
                                            <material:MaterialIcon Kind="SortAlphabeticalDescending" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource SortByDateDesc}" Command="{Binding SetSortOption}" CommandParameter="DateDesc">
                                        <MenuItem.Icon>
                                            <material:MaterialIcon Kind="SortCalendarDescending" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource SortByDateAsc}" Command="{Binding SetSortOption}" CommandParameter="DateAsc">
                                        <MenuItem.Icon>
                                            <material:MaterialIcon Kind="SortCalendarAscending" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Sort" Width="18" Height="18" Opacity="0.8" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{DynamicResource LabelSortBy}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text=":" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                <TextBlock Text="{Binding SelectedSortText}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Projects Grid -->
                <Border Grid.Row="2" Margin="24,0,24,24" Padding="0" CornerRadius="24" Background="Transparent" ClipToBounds="True">
                    <Panel>
                        <!-- Empty State Message -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" IsVisible="{Binding IsProjectsEmpty}">
                            <material:MaterialIcon Kind="{Binding EmptyStateIconKind}" Width="64" Height="64" Foreground="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.5"/>
                            <TextBlock Text="{DynamicResource LabelNothingHere}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                                      VerticalScrollBarVisibility="Auto" 
                                      Theme="{StaticResource MaterialModernScrollViewer}">
                        <ItemsControl ItemsSource="{Binding FilteredProjects}" Margin="24,24,24,48">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Margin="0,0,20,20" CornerRadius="24" ClipToBounds="True" Background="{DynamicResource SurfaceContainerHighestBrush}">
                                        <Grid RowDefinitions="140,Auto">
                                            <!-- Top (Thumbnail) Area -->
                                            <Button Grid.Row="0" Padding="0" BorderThickness="0" Background="Transparent"
                                                    Click="OpenVideo_Click" Cursor="Hand"
                                                    IsEnabled="{Binding ExportFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                 <Panel>
                                                     <Border Background="{DynamicResource SecondaryContainerBrush}"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             IsVisible="{Binding ThumbnailPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                         <Image Source="avares://MaterialFlow/Resources/Assets/logo.png"
                                                                Width="60" Height="60"
                                                                Stretch="Uniform"
                                                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmapConverter}}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding ThumbnailPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <!-- Play Overlay (fades in on hover via Window.Styles) -->
                                                    <Panel Name="PlayOverlay"
                                                           Opacity="0"
                                                           IsVisible="{Binding ExportFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <Panel.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                                            </Transitions>
                                                        </Panel.Transitions>
                                                        <Border Background="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                        <Border Width="52" Height="52" CornerRadius="26"
                                                                Background="{DynamicResource PrimaryBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                BoxShadow="0 4 16 0 #44000000">
                                                            <material:MaterialIcon Kind="Play" Width="28" Height="28" Foreground="White" Margin="4,0,0,0"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                            </Button>
                                            
                                            <!-- Bottom (Details) Area -->
                                            <Border Grid.Row="1" Background="{DynamicResource SurfaceVariantBrush}" Padding="16" CornerRadius="0,0,24,24">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OnSecondaryContainerBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <Panel Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                                                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                                            <TextBlock Text="{Binding StatusText}" Opacity="0.8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextTrimming="CharacterEllipsis"/>
                                                        </Panel>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <controls:Card CornerRadius="12" Padding="2" Width="24" Height="24" Background="{DynamicResource SecondaryContainerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsProcessing}">
                                                            <ProgressBar Classes="circular" Value="{Binding Progress}" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                                        </controls:Card>
                                                        
                                                        <Button Background="Transparent" Width="32" Height="32" Padding="0" CornerRadius="10"
                                                                Command="{Binding $parent[Window].DataContext.ProjectList.ToggleFavorite}" CommandParameter="{Binding}">
                                                            <Panel>
                                                                <material:MaterialIcon Kind="StarOutline" Width="20" Height="20" Opacity="0.6" Foreground="{DynamicResource OnSecondaryContainerBrush}" IsVisible="{Binding !IsFavorite}"/>
                                                                <material:MaterialIcon Kind="Star" Width="20" Height="20" Foreground="#FFB300" IsVisible="{Binding IsFavorite}"/>
                                                            </Panel>
                                                        </Button>

                                                        <Button Background="Transparent" Width="32" Height="32" Padding="0" CornerRadius="10">
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <MenuItem Header="{DynamicResource LabelAddToFavorites}" Command="{Binding $parent[Window].DataContext.ProjectList.ToggleFavorite}" CommandParameter="{Binding}" IsVisible="{Binding !IsFavorite}">
                                                                        <MenuItem.Icon>
                                                                            <material:MaterialIcon Kind="Star" Foreground="#FFB300" Width="16" Height="16"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="{DynamicResource LabelRemoveFromFavorites}" Command="{Binding $parent[Window].DataContext.ProjectList.ToggleFavorite}" CommandParameter="{Binding}" IsVisible="{Binding IsFavorite}">
                                                                        <MenuItem.Icon>
                                                                            <material:MaterialIcon Kind="StarOutline" Width="16" Height="16"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="{DynamicResource LabelRename}" Click="RenameProject_Click">
                                                                        <MenuItem.Icon>
                                                                            <material:MaterialIcon Kind="PencilOutline" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="{DynamicResource LabelProperties}" Click="PropertiesProject_Click">
                                                                        <MenuItem.Icon>
                                                                            <material:MaterialIcon Kind="InformationOutline" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="{DynamicResource LabelDelete}" Foreground="Red" Click="DeleteProject_Click">
                                                                        <MenuItem.Icon>
                                                                            <material:MaterialIcon Kind="TrashCanOutline" Foreground="Red" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                            <material:MaterialIcon Kind="DotsVertical" Width="20" Height="20" Opacity="0.6" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Panel>
                </Border>

                <!-- Pagination Controls -->
                <Border Grid.Row="3" Margin="24,0,24,24" Padding="16,8" CornerRadius="24" Background="{DynamicResource SurfaceVariantBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LabelItemsPerPage}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <Button Classes="SecondaryCapsule" Height="36" Padding="16,0" CornerRadius="18" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="20" Command="{Binding SetPageSize}" CommandParameter="20" />
                                        <MenuItem Header="50" Command="{Binding SetPageSize}" CommandParameter="50" />
                                        <MenuItem Header="100" Command="{Binding SetPageSize}" CommandParameter="100" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding PageSize}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <material:MaterialIcon Kind="ChevronDown" Width="18" Height="18" Opacity="0.8" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Button Classes="SecondaryCapsule" Height="36" Padding="16,0" CornerRadius="18" 
                                    Command="{Binding PreviousPage}" 
                                    IsEnabled="{Binding CurrentPage, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                                    <TextBlock Text="{DynamicResource LabelPrevious}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LabelPage}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource LabelOf}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>

                            <Button Classes="SecondaryCapsule" Height="36" Padding="16,0" CornerRadius="18" 
                                    Command="{Binding NextPage}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource LabelNext}" VerticalAlignment="Center" />
                                    <material:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Settings Page -->
            <views:SettingsView IsVisible="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"/>

            <!-- Presets Page -->
            <Panel IsVisible="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=2}">
                <views:PresetsView />
            </Panel>

            <!-- Platforms Page -->
            <Panel IsVisible="{Binding CurrentPageIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=3}">
                <views:PlatformsView />
            </Panel>
        </Panel>
    </Border>
</Grid>
</Window>

