<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:vm="using:MaterialFlow.ViewModels"
        x:Class="MaterialFlow.Views.CreatePresetWindow"
        x:DataType="vm:CreatePresetViewModel"
        Title="{Binding WindowTitle}"
        Width="550"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="ComboBox.dense">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="32" Background="{DynamicResource SurfaceVariantBrush}" Padding="32" Margin="10" BoxShadow="0 8 32 0 #20000000">
        <Border.Styles>
            <Style Selector="Border">
                <Style.Animations>
                    <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="32" FontWeight="Normal" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="16">
                    <!-- Name Input -->
                <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                         p1:TextFieldAssist.Label="Preset Name"
                         
                         Background="{DynamicResource SurfaceVariantBrush}"
                         
                         Text="{Binding PresetName}"/>

                <!-- Platform Selection -->
                <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                          p1:ComboBoxAssist.Label="Platform" 
                          Classes="dense"
                          ItemsSource="{Binding Platforms}" 
                          SelectedItem="{Binding SelectedPlatform}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Settings -->
                <!-- Manual Mode Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource LabelManualSettings}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <CheckBox IsChecked="{Binding IsManualMode}" Theme="{StaticResource MaterialCheckBox}"/>
                </StackPanel>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                    <Panel Grid.Row="0" Grid.Column="0" Margin="0,0,8,16">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="Resolution" 
                                  Classes="dense"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding Resolution}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="Resolution"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding Resolution}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <Panel Grid.Row="0" Grid.Column="1" Margin="8,0,0,16">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="Bitrate (kbps)" 
                                  Classes="dense"
                                  ItemsSource="{Binding Bitrates}"
                                  SelectedItem="{Binding Bitrate}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="Bitrate (kbps)"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding Bitrate}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <Panel Grid.Row="1" Grid.Column="0" Margin="0,0,8,16">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="FPS" 
                                  Classes="dense"
                                  ItemsSource="{Binding FrameRates}"
                                  SelectedItem="{Binding FrameRate}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="FPS"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding FrameRate}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <Panel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="Codec" 
                                  Classes="dense"
                                  ItemsSource="{Binding Codecs}"
                                  SelectedItem="{Binding Codec}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="Codec"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding Codec}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#B3261E" 
                           FontWeight="Medium" 
                           FontSize="14" 
                           HorizontalAlignment="Right" 
                           Margin="0,0,0,16"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                           
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="24">
                    <Button Content="Cancel" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Cancel_Click" FontSize="16"/>
                    <Button Content="Save" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Save_Click" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
