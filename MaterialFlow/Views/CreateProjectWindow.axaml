<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:vm="using:MaterialFlow.ViewModels"
        xmlns:conv="using:MaterialFlow.Converters"
        x:Class="MaterialFlow.Views.CreateProjectWindow"
        x:DataType="vm:CreateProjectViewModel"
        Title="{DynamicResource HeaderCreateProject}"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.Chip">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder" 
                            Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="16" 
                            Padding="10,6" 
                            Margin="0,0,5,8">
                        <ContentPresenter Name="PART_ContentPresenter" 
                                   Content="{TemplateBinding Content}" 
                                   TextElement.Foreground="{DynamicResource OnSurfaceBrush}" 
                                   TextElement.FontWeight="Medium"
                                   TextElement.FontSize="13"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ Border#PART_RootBorder">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>
        
        <Style Selector="ComboBox.dense">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox.dense:disabled">
            <!-- ������ ��������� "�����" ���� IsEnabled = false -->
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="32" Background="{DynamicResource SurfaceVariantBrush}" Padding="24" Margin="10" BoxShadow="0 8 32 0 #20000000">
        <Border.Styles>
            <Style Selector="Border">
                <Style.Animations>
                    <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{DynamicResource HeaderCreateProject}" FontSize="26" FontWeight="Normal" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Spacing="10">
                    <!-- Name Input -->
                <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                         p1:TextFieldAssist.Label="{DynamicResource LabelProjectName}"
                         
                         Background="{DynamicResource SurfaceVariantBrush}"
                         
                         Text="{Binding ProjectName}"/>

                <!-- Source File Selection -->
                <Panel>
                    <!-- Button when no file selected -->
                    <Button Theme="{StaticResource MaterialOutlineButton}"
                            Height="44" 
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding !IsSourceFileSelected}"
                            Click="SelectSourceFile_Click"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            CornerRadius="28">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <material:MaterialIcon Kind="FileVideoOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource LabelSelectVideoFile}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- File info when selected -->
                    <Border Height="44" 
                            CornerRadius="22" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Background="{DynamicResource SecondaryContainerBrush}"
                            Padding="16,0"
                            IsVisible="{Binding IsSourceFileSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <material:MaterialIcon Kind="FileCheck" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SourceFileName}" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0"
                                       Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" 
                                    Theme="{StaticResource MaterialFlatButton}"
                                    Width="40" Height="40" 
                                    Padding="0"
                                    Click="SelectSourceFile_Click"
                                    ToolTip.Tip="Change file">
                                <material:MaterialIcon Kind="SwapHorizontal" Width="20" Height="20" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Panel>

                <!-- Export Folder Input -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="PathTextBox"
                             Theme="{StaticResource MaterialOutlineTextBox}"
                             p1:TextFieldAssist.Label="{DynamicResource LabelExportTo}"
                             Classes="outline"
                             Background="{DynamicResource SurfaceVariantBrush}"
                             UseFloatingPlaceholder="True"
                             IsReadOnly="True"
                             PlaceholderText="{DynamicResource LabelSavePathPlaceholder}"
                             Text="{Binding SavePath}"/>
                    <Button Grid.Column="1" 
                            Classes="Flat" 
                            Width="48" Height="48" 
                            Margin="8,4,0,0"
                            Padding="0"
                            Click="SelectPath_Click">
                        <material:MaterialIcon Kind="FolderOpen" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Platform Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource HeaderPlatform}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <ListBox ItemsSource="{Binding AvailablePlatforms}" SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}" 
                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0,0,5,8"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Name="PART_RootBorder" 
                                                Background="{TemplateBinding Background}" 
                                                CornerRadius="16" 
                                                Padding="{TemplateBinding Padding}" 
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter Name="PART_ContentPresenter" 
                                                              Content="{TemplateBinding Content}" 
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" 
                                                              TextElement.FontWeight="Medium"
                                                              TextElement.FontSize="13"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ Border#PART_RootBorder">
                                <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>

                <!-- Preset Selection -->
                <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                          p1:ComboBoxAssist.Label="Select Preset" 
                          Classes="dense"
                          Foreground="{DynamicResource PrimaryBrush}"
                          ItemsSource="{Binding AvailablePresets}"
                          SelectedItem="{Binding SelectedPreset}"
                          IsVisible="{Binding IsPresetSelectionVisible}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                 <!-- Settings -->
                <!-- Manual Mode Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource LabelManualSettings}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <CheckBox IsChecked="{Binding IsManualMode}" Theme="{StaticResource MaterialCheckBox}"/>
                </StackPanel>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                    <!-- Resolution -->
                    <Panel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <ComboBox Name="ResolutionComboBox"
                                  Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="{DynamicResource HeaderResolution}" 
                                  Classes="dense"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}"
                                  IsEnabled="{Binding IsManualSettingsEnabled}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="{DynamicResource HeaderResolution}"
                                 Watermark="e.g. 1920x1080"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding SelectedResolution}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <!-- Bitrate -->
                    <Panel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="{DynamicResource HeaderBitrate}" 
                                  Classes="dense"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  ItemsSource="{Binding Bitrates}"
                                  SelectedItem="{Binding SelectedBitrate}"
                                  IsEnabled="{Binding IsManualSettingsEnabled}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="{DynamicResource HeaderBitrate}"
                                 Watermark="e.g. 5000"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding SelectedBitrate}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <!-- FPS -->
                    <Panel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="FPS (fps)" 
                                  Classes="dense"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  ItemsSource="{Binding FPSs}"
                                  SelectedItem="{Binding SelectedFPS}"
                                  IsEnabled="{Binding IsManualSettingsEnabled}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="FPS (fps)"
                                 Watermark="e.g. 60"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding SelectedFPS}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <!-- Codec -->
                    <Panel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="{DynamicResource HeaderCodec}" 
                                  Classes="dense"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  ItemsSource="{Binding Codecs}"
                                  SelectedItem="{Binding SelectedCodec}"
                                  IsEnabled="{Binding IsManualSettingsEnabled}"
                                  IsVisible="{Binding !IsManualMode}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="{DynamicResource HeaderCodec}"
                                 Watermark="e.g. libx264"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding SelectedCodec}"
                                 IsVisible="{Binding IsManualMode}"
                                 HorizontalAlignment="Stretch"/>
                    </Panel>

                    <!-- Format (always editable) -->
                    <Panel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                        <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                                  p1:ComboBoxAssist.Label="{DynamicResource HeaderFormat}" 
                                  Classes="dense"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}"
                                  IsVisible="{Binding !IsManualMode}"/>
                        <TextBox UseFloatingPlaceholder="True" Classes="outline dense" Theme="{StaticResource OutlineTextBox}"
                                 p1:TextFieldAssist.Label="{DynamicResource HeaderFormat}"
                                 Watermark="e.g. .mp4"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Text="{Binding SelectedFormat}"
                                 IsVisible="{Binding IsManualMode}"/>
                    </Panel>
                </Grid>

                <!-- Watermark -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <TextBlock Text="{DynamicResource HeaderWatermark}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <CheckBox IsChecked="{Binding UseWatermark}" Theme="{StaticResource MaterialCheckBox}"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#B3261E" 
                           FontWeight="Medium" 
                           FontSize="14" 
                           HorizontalAlignment="Right" 
                           Margin="0,0,0,16"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                           
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="24">
                    <Button Content="{DynamicResource BtnCancel}" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Cancel_Click" FontSize="16"/>
                    <Button Content="{DynamicResource BtnCreate}" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Create_Click" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
