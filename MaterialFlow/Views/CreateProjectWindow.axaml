<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:vm="using:MaterialFlow.ViewModels"
        xmlns:conv="using:MaterialFlow.Converters"
        x:Class="MaterialFlow.Views.CreateProjectWindow"
        x:DataType="vm:CreateProjectViewModel"
        Title="{DynamicResource HeaderCreateProject}"
        Width="550"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.Chip">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder" 
                            Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="20" 
                            Padding="16,8" 
                            Margin="0,0,8,8">
                        <TextBlock Name="PART_Text" 
                                   Text="{TemplateBinding Content}" 
                                   Foreground="{DynamicResource OnSurfaceBrush}" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ Border#PART_RootBorder">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ TextBlock#PART_Text">
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>
        
        <Style Selector="ComboBox.dense">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="32" Background="{DynamicResource SurfaceVariantBrush}" Padding="32" Margin="10" BoxShadow="0 8 32 0 #20000000">
        <Border.Styles>
            <Style Selector="Border">
                <Style.Animations>
                    <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{DynamicResource HeaderCreateProject}" FontSize="32" FontWeight="Normal" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="16">
                <!-- Name Input -->
                <TextBox Theme="{StaticResource MaterialOutlineTextBox}"
                         p1:TextFieldAssist.Label="{DynamicResource LabelProjectName}"
                         Classes="outline"
                         Background="{DynamicResource SurfaceVariantBrush}"
                         UseFloatingPlaceholder="True"
                         Text="{Binding ProjectName}"/>

                <!-- Source File Selection -->
                <Panel>
                    <!-- Button when no file selected -->
                    <Button Theme="{StaticResource MaterialOutlineButton}"
                            Height="56" 
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding !IsSourceFileSelected}"
                            Click="SelectSourceFile_Click"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            CornerRadius="28">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <material:MaterialIcon Kind="FileVideoOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource LabelSelectVideoFile}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- File info when selected -->
                    <Border Height="56" 
                            CornerRadius="28" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Background="{DynamicResource SecondaryContainerBrush}"
                            Padding="16,0"
                            IsVisible="{Binding IsSourceFileSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <material:MaterialIcon Kind="FileCheck" Width="24" Height="24" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SourceFileName}" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0"
                                       Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" 
                                    Theme="{StaticResource MaterialFlatButton}"
                                    Width="40" Height="40" 
                                    Padding="0"
                                    Click="SelectSourceFile_Click"
                                    ToolTip.Tip="Change file">
                                <material:MaterialIcon Kind="SwapHorizontal" Width="20" Height="20" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Panel>

                <!-- Export Folder Input -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="PathTextBox"
                             Theme="{StaticResource MaterialOutlineTextBox}"
                             p1:TextFieldAssist.Label="{DynamicResource LabelExportTo}"
                             Classes="outline"
                             Background="{DynamicResource SurfaceVariantBrush}"
                             UseFloatingPlaceholder="True"
                             IsReadOnly="True"
                             PlaceholderText="{DynamicResource LabelSavePathPlaceholder}"
                             Text="{Binding SavePath}"/>
                    <Button Grid.Column="1" 
                            Classes="Flat" 
                            Width="48" Height="48" 
                            Margin="8,4,0,0"
                            Padding="0"
                            Click="SelectPath_Click">
                        <material:MaterialIcon Kind="FolderOpen" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Platform Selection -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource HeaderPlatform}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <WrapPanel>
                        <RadioButton Content="YouTube" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"/>
                        <RadioButton Content="TikTok" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=TikTok}"/>
                        <RadioButton Content="Facebook" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Facebook}"/>
                        <RadioButton Content="Instagram" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Instagram}"/>
                        <RadioButton Content="Other" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Other}"/>
                    </WrapPanel>
                </StackPanel>

                 <!-- Settings -->
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                    <ComboBox Name="ResolutionComboBox"
                              Grid.Row="0" Grid.Column="0" Margin="0,0,8,16"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="{DynamicResource HeaderResolution}" 
                              Classes="dense"
                              Foreground="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution}"/>

                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,16"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="{DynamicResource HeaderBitrate}" 
                              Classes="dense"
                              Foreground="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding Bitrates}"
                              SelectedItem="{Binding SelectedBitrate}"/>

                    <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,16"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="{DynamicResource HeaderFPS}" 
                              Classes="dense"
                              Foreground="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding FPSs}"
                              SelectedItem="{Binding SelectedFPS}"/>

                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,16"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="{DynamicResource HeaderFormat}" 
                              Classes="dense"
                              Foreground="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}"/>

                    <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="{DynamicResource HeaderCodec}" 
                              Classes="dense"
                              Foreground="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding Codecs}"
                              SelectedItem="{Binding SelectedCodec}"/>
                </Grid>

                <!-- Watermark -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource HeaderWatermark}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                    <CheckBox IsChecked="{Binding UseWatermark}" Theme="{StaticResource MaterialCheckBox}"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#B3261E" 
                           FontWeight="Medium" 
                           FontSize="14" 
                           HorizontalAlignment="Right" 
                           Margin="0,0,0,16"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                           
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="24">
                    <Button Content="{DynamicResource BtnCancel}" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Cancel_Click" FontSize="16"/>
                    <Button Content="{DynamicResource BtnCreate}" Classes="Flat" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Click="Create_Click" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
