<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:vm="using:MaterialFlow.ViewModels"
        xmlns:conv="using:MaterialFlow.Converters"
        x:Class="MaterialFlow.Views.CreateProjectWindow"
        x:DataType="vm:CreateProjectViewModel"
        Title="Create Project"
        Width="550"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.Chip">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder" 
                            Background="White" 
                            CornerRadius="20" 
                            Padding="16,8" 
                            Margin="0,0,8,8">
                        <TextBlock Name="PART_Text" 
                                   Text="{TemplateBinding Content}" 
                                   Foreground="#1D1B20" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ Border#PART_RootBorder">
            <Setter Property="Background" Value="#EADDFF"/>
        </Style>
        <Style Selector="RadioButton.Chip:checked /template/ TextBlock#PART_Text">
            <Setter Property="Foreground" Value="#21005D"/>
        </Style>
        
        <Style Selector="ComboBox.dense">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="32" Background="#F3EDF7" Padding="32" Margin="10" BoxShadow="0 8 32 0 #20000000">
        <Border.Styles>
            <Style Selector="Border">
                <Style.Animations>
                    <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Create Project" FontSize="32" FontWeight="Normal" Foreground="#1D1B20" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="16">
                <!-- Name Input -->
                <TextBox Theme="{StaticResource MaterialOutlineTextBox}"
                         p1:TextFieldAssist.Label="Project Name"
                         Classes="outline"
                         Background="#F3EDF7"
                         UseFloatingPlaceholder="True"
                         Text="{Binding ProjectName}"/>

                <!-- Source File Selection -->
                <Panel>
                    <!-- Button when no file selected -->
                    <Button Theme="{StaticResource MaterialOutlineButton}"
                            Height="56" 
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding !IsSourceFileSelected}"
                            Click="SelectSourceFile_Click"
                            BorderBrush="#6750A4"
                            CornerRadius="28">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <material:MaterialIcon Kind="FileVideoOutline" Width="24" Height="24" Foreground="#6750A4"/>
                            <TextBlock Text="Select Video File" VerticalAlignment="Center" Foreground="#6750A4" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- File info when selected -->
                    <Border Height="56" 
                            CornerRadius="28" 
                            BorderThickness="1" 
                            BorderBrush="#6750A4"
                            Background="#EADDFF"
                            Padding="16,0"
                            IsVisible="{Binding IsSourceFileSelected}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <material:MaterialIcon Kind="FileCheck" Width="24" Height="24" Foreground="#21005D"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SourceFileName}" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0"
                                       Foreground="#21005D"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" 
                                    Theme="{StaticResource MaterialFlatButton}"
                                    Width="40" Height="40" 
                                    Padding="0"
                                    Click="SelectSourceFile_Click"
                                    ToolTip.Tip="Change file">
                                <material:MaterialIcon Kind="SwapHorizontal" Width="20" Height="20" Foreground="#21005D"/>
                            </Button>
                        </Grid>
                    </Border>
                </Panel>

                <!-- Export Folder Input -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="PathTextBox"
                             Theme="{StaticResource MaterialOutlineTextBox}"
                             p1:TextFieldAssist.Label="Export to"
                             Classes="outline"
                             Background="#F3EDF7"
                             UseFloatingPlaceholder="True"
                             IsReadOnly="True"
                             PlaceholderText="Select destination folder..."
                             Text="{Binding SavePath}"/>
                    <Button Grid.Column="1" 
                            Classes="Flat" 
                            Width="48" Height="48" 
                            Margin="8,4,0,0"
                            Padding="0"
                            Click="SelectPath_Click">
                        <material:MaterialIcon Kind="FolderOpen" Width="24" Height="24" Foreground="#6750A4"/>
                    </Button>
                </Grid>

                <!-- Platform Selection -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Platform" Foreground="#6750A4" FontWeight="Bold" FontSize="14"/>
                    <WrapPanel>
                        <RadioButton Content="YouTube" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"/>
                        <RadioButton Content="TikTok" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=TikTok}"/>
                        <RadioButton Content="Facebook" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Facebook}"/>
                        <RadioButton Content="Instagram" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Instagram}"/>
                        <RadioButton Content="Other" Classes="Chip" GroupName="Platform"
                                     IsChecked="{Binding SelectedPlatform, Converter={StaticResource EqualityConverter}, ConverterParameter=Other}"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Settings -->
                <StackPanel Spacing="16">
                    <ComboBox Name="ResolutionComboBox"
                              Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="Resolution" 
                              Classes="dense"
                              Foreground="#6750A4"
                              ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution}"/>

                    <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="Bitrate" 
                              Classes="dense"
                              Foreground="#6750A4"
                              SelectedItem="{Binding SelectedBitrate}">
                        <ComboBoxItem>Auto</ComboBoxItem>
                        <ComboBoxItem>5 Mbps</ComboBoxItem>
                        <ComboBoxItem>10 Mbps</ComboBoxItem>
                    </ComboBox>

                    <ComboBox Theme="{StaticResource MaterialOutlineComboBox}" 
                              p1:ComboBoxAssist.Label="Format" 
                              Classes="dense"
                              Foreground="#6750A4"
                              SelectedItem="{Binding SelectedFormat}">
                        <ComboBoxItem>.mp4</ComboBoxItem>
                        <ComboBoxItem>.mkv</ComboBoxItem>
                        <ComboBoxItem>.avi</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Watermark -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="Watermark" VerticalAlignment="Center" Foreground="#6750A4" FontWeight="Bold" FontSize="14"/>
                    <CheckBox IsChecked="{Binding UseWatermark}" Theme="{StaticResource MaterialCheckBox}"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="24" Margin="0,16,0,0">
                <Button Content="Cancel" Classes="Flat" Foreground="#6750A4" FontWeight="Bold" Click="Cancel_Click" FontSize="16"/>
                <Button Content="Create" Classes="Flat" Foreground="#6750A4" FontWeight="Bold" Click="Create_Click" FontSize="16"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
