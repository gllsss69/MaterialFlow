<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <!-- Sidebar / Navigation -->
    <sys:String x:Key="NavHome">Startseite</sys:String>
    <sys:String x:Key="NavSettings">Einstellungen</sys:String>
    <sys:String x:Key="LabelLogin">Anmelden</sys:String>
    <sys:String x:Key="LabelLogout">Abmelden</sys:String>
    <sys:String x:Key="LabelGuest">Gast</sys:String>

    <!-- Home Page Toolbar -->
    <sys:String x:Key="BtnCreateProject">Projekt erstellen</sys:String>
    <sys:String x:Key="LabelSearchPlaceholder">Projekte suchen...</sys:String>
    <sys:String x:Key="LabelAllProjects">Alle Projekte</sys:String>
    <sys:String x:Key="LabelRecent">Zuletzt verwendet</sys:String>
    <sys:String x:Key="LabelFavorites">Favoriten</sys:String>
    
    <!-- Project Card Menu -->
    <sys:String x:Key="LabelRename">Umbenennen</sys:String>
    <sys:String x:Key="LabelProperties">Eigenschaften</sys:String>
    <sys:String x:Key="LabelDelete">Löschen</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="HeaderSettings">Einstellungen</sys:String>
    <sys:String x:Key="HeaderLanguage">Sprache</sys:String>
    <sys:String x:Key="LabelSelectLanguage">Sprache auswählen</sys:String>
    <sys:String x:Key="HeaderTheme">Design</sys:String>
    <sys:String x:Key="LabelSelectTheme">Design auswählen</sys:String>
    <sys:String x:Key="HeaderSavePath">Speicherpfad für Projekte</sys:String>
    <sys:String x:Key="LabelPathForProjects">Pfad für Projekte</sys:String>
    <sys:String x:Key="LabelSavePathPlaceholder">Zielordner auswählen...</sys:String>

    <!-- Create Project Window -->
    <sys:String x:Key="HeaderCreateProject">Projekt erstellen</sys:String>
    <sys:String x:Key="LabelProjectName">Projektname</sys:String>
    <sys:String x:Key="LabelSelectVideoFile">Videodatei auswählen</sys:String>
    <sys:String x:Key="LabelExportTo">Exportieren nach</sys:String>
    <sys:String x:Key="HeaderPlatform">Plattform</sys:String>
    <sys:String x:Key="HeaderResolution">Auflösung</sys:String>
    <sys:String x:Key="HeaderBitrate">Bitrate (kbps)</sys:String>
    <sys:String x:Key="HeaderFPS">FPS</sys:String>
    <sys:String x:Key="HeaderFormat">Format</sys:String>
    <sys:String x:Key="HeaderCodec">Codec</sys:String>
    <sys:String x:Key="HeaderWatermark">Wasserzeichen</sys:String>
    <sys:String x:Key="BtnCancel">Abbrechen</sys:String>
    <sys:String x:Key="BtnCreate">Erstellen</sys:String>

    <!-- Rename Project Window -->
    <sys:String x:Key="HeaderRenameProject">Projekt umbenennen</sys:String>
    <sys:String x:Key="LabelNewName">Neuer Name</sys:String>
    <sys:String x:Key="ErrorProjectExists">Ein Projekt mit diesem Namen existiert bereits.</sys:String>
    <sys:String x:Key="BtnSave">Speichern</sys:String>

    <!-- Properties Window -->
    <sys:String x:Key="HeaderProperties">Eigenschaften</sys:String>
    <sys:String x:Key="LabelName">Name</sys:String>
    <sys:String x:Key="LabelResolution">Auflösung</sys:String>
    <sys:String x:Key="LabelBitrate">Bitrate</sys:String>
    <sys:String x:Key="LabelFormat">Format</sys:String>
    <sys:String x:Key="LabelCodec">Codec</sys:String>
    <sys:String x:Key="LabelFPS">FPS</sys:String>
    <sys:String x:Key="LabelSize">Größe</sys:String>
    <sys:String x:Key="LabelPath">Pfad</sys:String>
    <sys:String x:Key="BtnBack">Zurück</sys:String>

    <!-- Login Window -->
    <sys:String x:Key="LoginTitleLogin">Anmelden</sys:String>
    <sys:String x:Key="LoginTitleRegister">Konto erstellen</sys:String>
    <sys:String x:Key="LoginLabelLogin">Benutzername</sys:String>
    <sys:String x:Key="LoginLabelFullName">Vollständiger Name</sys:String>
    <sys:String x:Key="LoginLabelPassword">Passwort</sys:String>
    <sys:String x:Key="LoginBtnLogin">Anmelden</sys:String>
    <sys:String x:Key="LoginBtnRegister">Registrieren</sys:String>
    <sys:String x:Key="LoginSwitchToRegister">Kein Konto? Registrieren</sys:String>
    <sys:String x:Key="LoginSwitchToLogin">Bereits ein Konto? Anmelden</sys:String>

    <!-- Sorting & Favorites -->
    <sys:String x:Key="SortByNameAsc">Name (A-Z)</sys:String>
    <sys:String x:Key="SortByNameDesc">Name (Z-A)</sys:String>
    <sys:String x:Key="SortByDateDesc">Neueste zuerst</sys:String>
    <sys:String x:Key="SortByDateAsc">Älteste zuerst</sys:String>
    <sys:String x:Key="LabelSortBy">Sortieren</sys:String>
    <sys:String x:Key="LabelAddToFavorites">Zu Favoriten hinzufügen</sys:String>
    <sys:String x:Key="LabelRemoveFromFavorites">Aus Favoriten entfernen</sys:String>
    
    <!-- Pagination -->
    <sys:String x:Key="LabelItemsPerPage">Anzahl der Elemente pro Seite</sys:String>
    <sys:String x:Key="LabelPrevious">Vor</sys:String>
    <sys:String x:Key="LabelNext">Nächste</sys:String>
    <sys:String x:Key="LabelPage">Seite</sys:String>
    <sys:String x:Key="LabelOf">von</sys:String>

    <!-- General UI -->
    <sys:String x:Key="LabelStatus">Status:</sys:String>
    <sys:String x:Key="LabelPlatform">Plattform:</sys:String>
    <sys:String x:Key="LabelNothingHere">Noch nichts hier</sys:String>
    <sys:String x:Key="LabelEnableLogging">Protokollierung in Datei aktivieren</sys:String>
    <sys:String x:Key="HeaderFFmpegStatus">FFmpeg-Status</sys:String>
    <sys:String x:Key="BtnRefreshStatus">Status aktualisieren</sys:String>
    <sys:String x:Key="HeaderAbout">Über</sys:String>
    <sys:String x:Key="TextAboutDescription">Ein fortschrittliches Tool zur Videoanpassung und Preset-Verwaltung.</sys:String>
    <sys:String x:Key="BtnViewGitHub">Auf GitHub ansehen</sys:String>
    <sys:String x:Key="NavPresets">Voreinstellungen</sys:String>
    <sys:String x:Key="NavPlatforms">Plattformen</sys:String>
    <sys:String x:Key="FilterAll">Alle</sys:String>
    <sys:String x:Key="FilterCompleted">Fertig</sys:String>
    <sys:String x:Key="FilterError">Fehler</sys:String>
    <sys:String x:Key="FilterProcessing">Verarbeitung</sys:String>
    <sys:String x:Key="LabelManualSettings">Manuelle Einstellungen</sys:String>
    <sys:String x:Key="ErrorEmptyPlatform">Bitte wählen Sie eine Plattform aus.</sys:String>
    <sys:String x:Key="ErrorEmptyFormat">Bitte wählen Sie ein Videoformat aus.</sys:String>
    <sys:String x:Key="ErrorPlatformExists">Eine Plattform mit diesem Namen existiert bereits.</sys:String>
    <sys:String x:Key="ErrorEmptySavePath">Bitte wählen Sie einen Exportordner aus.</sys:String>
    <sys:String x:Key="ErrorEmptyFPS">Bitte wählen Sie eine Bildrate (FPS) aus.</sys:String>
    <sys:String x:Key="ErrorEmptySourceFile">Bitte wählen Sie eine Quell-Videodatei aus.</sys:String>
    <sys:String x:Key="ErrorEmptyResolution">Bitte wählen Sie eine Auflösung aus.</sys:String>
    <sys:String x:Key="ErrorEmptyProjectName">Der Projektname darf nicht leer sein.</sys:String>
    <sys:String x:Key="ErrorEmptyBitrate">Bitte wählen Sie eine Bitrate aus.</sys:String>
    <sys:String x:Key="ErrorInvalidBitrate">Ungültige Bitrate (z.B. 5000).</sys:String>
    <sys:String x:Key="ErrorEmptyCodec">Bitte wählen Sie einen Codec aus.</sys:String>
    <sys:String x:Key="ErrorInvalidResolution">Ungültige Auflösung (z.B. 1920x1080).</sys:String>
    <sys:String x:Key="ErrorEmptyPresetName">Der Preset-Name darf nicht leer sein.</sys:String>
    <sys:String x:Key="ErrorEmptyPlatformName">Bitte geben Sie einen Plattformnamen ein.</sys:String>
    <sys:String x:Key="ErrorInvalidFPS">Ungültige FPS (z.B. 30 oder 60).</sys:String>
    <sys:String x:Key="ErrorInvalidFormat">Ungültiges Format (z.B. .mp4).</sys:String>
    <sys:String x:Key="ErrorInvalidCodec">Ungültiger Codec (z.B. libx264).</sys:String>
    <sys:String x:Key="LabelRole">Rolle</sys:String>
    <sys:String x:Key="LabelSelectPreset">Preset auswählen</sys:String>
    <sys:String x:Key="TitleCreatePlatform">Plattform erstellen</sys:String>
    <sys:String x:Key="TitleEditPlatform">Plattform bearbeiten</sys:String>
    <sys:String x:Key="TitleCreatePreset">Preset erstellen</sys:String>
    <sys:String x:Key="TitleEditPreset">Bearbeiten preset</sys:String>
    <sys:String x:Key="LabelIcon">Symbol</sys:String>
    <sys:String x:Key="MsgAdminEditPlatforms">Melden Sie sich als Administrator an, um Plattformen zu bearbeiten.</sys:String>
    <sys:String x:Key="BtnCreatePlatform">Plattform erstellen</sys:String>
    <sys:String x:Key="LabelSearchPlatforms">Plattformen suchen...</sys:String>
    <sys:String x:Key="MsgAdminEditPresets">Melden Sie sich als Administrator an, um Presets zu bearbeiten.</sys:String>
    <sys:String x:Key="BtnCreatePreset">Preset erstellen</sys:String>
    <sys:String x:Key="LabelSearchPresets">Presets suchen...</sys:String>
    <sys:String x:Key="TextAppVersion">Version 1.0.1</sys:String>
    <sys:String x:Key="LabelPlatformName">Plattformname</sys:String>
    <sys:String x:Key="LabelPresetName">Preset-Name</sys:String>
    <sys:String x:Key="BtnEdit">Bearbeiten</sys:String>
    <sys:String x:Key="PlaceholderResolution">z.B. 1920x1080</sys:String>
    <sys:String x:Key="PlaceholderBitrate">z.B. 5000</sys:String>
    <sys:String x:Key="PlaceholderFPS">z.B. 60</sys:String>
    <sys:String x:Key="PlaceholderCodec">z.B. libx264</sys:String>
    <sys:String x:Key="PlaceholderFormat">z.B. .mp4</sys:String>
    <sys:String x:Key="LabelFFmpegStatusPrefix">FFmpeg-Status:</sys:String>
    <sys:String x:Key="FFmpegAvailable">Verfügbar</sys:String>
    <sys:String x:Key="FFmpegNotFound">Nicht gefunden</sys:String>
    <sys:String x:Key="FFmpegNotFoundInPath">FFmpeg wurde im System-PATH nicht gefunden</sys:String>
    <sys:String x:Key="StatusError">Fehler</sys:String>
    <sys:String x:Key="StatusErrorCreatingDirectory">Fehler beim Erstellen des Ordners</sys:String>
    <sys:String x:Key="StatusPendingInQueue">Wartet in der Queue...</sys:String>
    <sys:String x:Key="StatusProcessing">Verarbeitung...</sys:String>
    <sys:String x:Key="StatusProcessingPrefix">Verarbeitung</sys:String>
    <sys:String x:Key="AuthLoginPasswordRequired">Login und Passwort sind erforderlich.</sys:String>
    <sys:String x:Key="AuthUserAlreadyExists">Benutzer existiert bereits.</sys:String>
    <sys:String x:Key="AuthRegistrationSuccessful">Registrierung erfolgreich.</sys:String>
    <sys:String x:Key="AuthInvalidLoginOrPassword">Ungültiger Login oder ungültiges Passwort.</sys:String>
    <sys:String x:Key="AuthLoginSuccessful">Login erfolgreich.</sys:String>
    <sys:String x:Key="DialogSelectSourceVideo">Quellvideo auswählen</sys:String>
    <sys:String x:Key="DialogVideoFiles">Videodateien</sys:String>
    <sys:String x:Key="DialogSelectDestinationFolder">Zielordner auswählen</sys:String>
    <sys:String x:Key="DialogSelectDefaultProjectsFolder">Standard-Projektordner auswählen</sys:String>
    <sys:String x:Key="LogProject">Projekt</sys:String>
    <sys:String x:Key="LogCreated">Erstellt</sys:String>
    <sys:String x:Key="LogSource">Quelle</sys:String>
</ResourceDictionary>
