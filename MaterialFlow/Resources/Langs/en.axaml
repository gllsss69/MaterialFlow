<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <!-- Sidebar / Navigation -->
    <sys:String x:Key="NavHome">Home</sys:String>
    <sys:String x:Key="NavSettings">Settings</sys:String>
    <sys:String x:Key="LabelLogin">Login</sys:String>
    <sys:String x:Key="LabelLogout">Logout</sys:String>
    <sys:String x:Key="LabelGuest">Guest</sys:String>

    <!-- Home Page Toolbar -->
    <sys:String x:Key="BtnCreateProject">Create Project</sys:String>
    <sys:String x:Key="LabelSearchPlaceholder">Search projects...</sys:String>
    <sys:String x:Key="LabelAllProjects">All Projects</sys:String>
    <sys:String x:Key="LabelRecent">Recent</sys:String>
    <sys:String x:Key="LabelFavorites">Favorites</sys:String>
    
    <!-- Project Card Menu -->
    <sys:String x:Key="LabelRename">Rename</sys:String>
    <sys:String x:Key="LabelProperties">Properties</sys:String>
    <sys:String x:Key="LabelDelete">Delete</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="HeaderSettings">Settings</sys:String>
    <sys:String x:Key="HeaderLanguage">Language</sys:String>
    <sys:String x:Key="LabelSelectLanguage">Select Language</sys:String>
    <sys:String x:Key="HeaderTheme">Theme</sys:String>
    <sys:String x:Key="LabelSelectTheme">Select Theme</sys:String>
    <sys:String x:Key="HeaderSavePath">Save path for projects</sys:String>
    <sys:String x:Key="LabelPathForProjects">Path for projects</sys:String>
    <sys:String x:Key="LabelSavePathPlaceholder">Select destination folder...</sys:String>

    <!-- Create Project Window -->
    <sys:String x:Key="HeaderCreateProject">Create Project</sys:String>
    <sys:String x:Key="LabelProjectName">Project Name</sys:String>
    <sys:String x:Key="LabelSelectVideoFile">Select Video File</sys:String>
    <sys:String x:Key="LabelExportTo">Export to</sys:String>
    <sys:String x:Key="HeaderPlatform">Platform</sys:String>
    <sys:String x:Key="HeaderResolution">Resolution</sys:String>
    <sys:String x:Key="HeaderBitrate">Bitrate (kbps)</sys:String>
    <sys:String x:Key="HeaderFPS">FPS</sys:String>
    <sys:String x:Key="HeaderFormat">Format</sys:String>
    <sys:String x:Key="HeaderCodec">Codec</sys:String>
    <sys:String x:Key="HeaderWatermark">Watermark</sys:String>
    <sys:String x:Key="BtnCancel">Cancel</sys:String>
    <sys:String x:Key="BtnCreate">Create</sys:String>

    <!-- Rename Project Window -->
    <sys:String x:Key="HeaderRenameProject">Rename Project</sys:String>
    <sys:String x:Key="LabelNewName">New Name</sys:String>
    <sys:String x:Key="ErrorProjectExists">A project with this name already exists.</sys:String>
    <sys:String x:Key="BtnSave">Save</sys:String>

    <!-- Properties Window -->
    <sys:String x:Key="HeaderProperties">Properties</sys:String>
    <sys:String x:Key="LabelName">Name</sys:String>
    <sys:String x:Key="LabelResolution">Resolution</sys:String>
    <sys:String x:Key="LabelBitrate">Bitrate</sys:String>
    <sys:String x:Key="LabelFormat">Format</sys:String>
    <sys:String x:Key="LabelCodec">Codec</sys:String>
    <sys:String x:Key="LabelFPS">FPS</sys:String>
    <sys:String x:Key="LabelSize">Size</sys:String>
    <sys:String x:Key="LabelPath">Path</sys:String>
    <sys:String x:Key="BtnBack">Back</sys:String>

    <!-- Login Window -->
    <sys:String x:Key="LoginTitleLogin">Login</sys:String>
    <sys:String x:Key="LoginTitleRegister">Create Account</sys:String>
    <sys:String x:Key="LoginLabelLogin">Login</sys:String>
    <sys:String x:Key="LoginLabelFullName">Full Name</sys:String>
    <sys:String x:Key="LoginLabelPassword">Password</sys:String>
    <sys:String x:Key="LoginBtnLogin">Login</sys:String>
    <sys:String x:Key="LoginBtnRegister">Register</sys:String>
    <sys:String x:Key="LoginSwitchToRegister">Don't have an account? Register</sys:String>
    <sys:String x:Key="LoginSwitchToLogin">Already have an account? Login</sys:String>
    <sys:String x:Key="LabelRole">Role</sys:String>

    <!-- Sorting & Favorites -->
    <sys:String x:Key="SortByNameAsc">Name (A-Z)</sys:String>
    <sys:String x:Key="SortByNameDesc">Name (Z-A)</sys:String>
    <sys:String x:Key="SortByDateDesc">Newest First</sys:String>
    <sys:String x:Key="SortByDateAsc">Oldest First</sys:String>
    <sys:String x:Key="LabelSortBy">Sort</sys:String>
    <sys:String x:Key="LabelAddToFavorites">Add to Favorites</sys:String>
    <sys:String x:Key="LabelRemoveFromFavorites">Remove from Favorites</sys:String>

    <!-- Pagination -->
    <sys:String x:Key="LabelItemsPerPage">Items per page:</sys:String>
    <sys:String x:Key="LabelPrevious">Previous</sys:String>
    <sys:String x:Key="LabelNext">Next</sys:String>
    <sys:String x:Key="LabelPage">Page</sys:String>
    <sys:String x:Key="LabelOf">of</sys:String>

    <!-- General UI -->
    <sys:String x:Key="LabelStatus">Status:</sys:String>
    <sys:String x:Key="LabelPlatform">Platform:</sys:String>
    <sys:String x:Key="LabelNothingHere">Nothing here yet</sys:String>
    <sys:String x:Key="LabelEnableLogging">Enable logging to file</sys:String>
    <sys:String x:Key="HeaderFFmpegStatus">FFmpeg Status</sys:String>
    <sys:String x:Key="BtnRefreshStatus">Refresh Status</sys:String>
    <sys:String x:Key="HeaderAbout">About</sys:String>
    <sys:String x:Key="TextAboutDescription">An advanced video adaptation and preset management tool.</sys:String>
    <sys:String x:Key="BtnViewGitHub">View on GitHub</sys:String>
    <sys:String x:Key="NavPresets">Presets</sys:String>
    <sys:String x:Key="NavPlatforms">Platforms</sys:String>
    <sys:String x:Key="FilterAll">All</sys:String>
    <sys:String x:Key="FilterCompleted">Completed</sys:String>
    <sys:String x:Key="FilterError">Error</sys:String>
    <sys:String x:Key="FilterProcessing">Processing</sys:String>
    <sys:String x:Key="LabelManualSettings">Manual settings</sys:String>
    <sys:String x:Key="ErrorEmptyPlatform">Please select a platform.</sys:String>
    <sys:String x:Key="ErrorEmptyFormat">Please select a video format.</sys:String>
    <sys:String x:Key="ErrorPlatformExists">A platform with this name already exists.</sys:String>
    <sys:String x:Key="ErrorEmptySavePath">Please select an export destination.</sys:String>
    <sys:String x:Key="ErrorEmptyFPS">Please select a frame rate (FPS).</sys:String>
    <sys:String x:Key="ErrorEmptySourceFile">Please select a source video file.</sys:String>
    <sys:String x:Key="ErrorEmptyResolution">Please select a resolution.</sys:String>
    <sys:String x:Key="ErrorEmptyProjectName">Project name cannot be empty.</sys:String>
    <sys:String x:Key="ErrorEmptyBitrate">Please select a bitrate.</sys:String>
    <sys:String x:Key="ErrorInvalidBitrate">Invalid bitrate (e.g., 5000).</sys:String>
    <sys:String x:Key="ErrorEmptyCodec">Please select a codec.</sys:String>
    <sys:String x:Key="ErrorInvalidResolution">Invalid resolution (e.g., 1920x1080).</sys:String>
    <sys:String x:Key="ErrorEmptyPresetName">Preset name cannot be empty.</sys:String>
    <sys:String x:Key="ErrorEmptyPlatformName">Please enter a platform name.</sys:String>
    <sys:String x:Key="ErrorInvalidFPS">Invalid FPS (e.g., 30 or 60).</sys:String>
    <sys:String x:Key="ErrorInvalidFormat">Invalid format (e.g., .mp4).</sys:String>
    <sys:String x:Key="ErrorInvalidCodec">Invalid codec (e.g., libx264).</sys:String>

    <!-- Additional UI Labels -->
    <sys:String x:Key="LabelIcon">Icon</sys:String>
    <sys:String x:Key="MsgAdminEditPlatforms">To edit platforms, log in as Administrator.</sys:String>
    <sys:String x:Key="BtnCreatePlatform">Create Platform</sys:String>
    <sys:String x:Key="LabelSearchPlatforms">Search platforms...</sys:String>
    <sys:String x:Key="MsgAdminEditPresets">To edit presets, log in as Administrator.</sys:String>
    <sys:String x:Key="BtnCreatePreset">Create Preset</sys:String>
    <sys:String x:Key="LabelSearchPresets">Search presets...</sys:String>
    <sys:String x:Key="TextAppVersion">Version 1.0.1</sys:String>
    <sys:String x:Key="LabelPlatformName">Platform Name</sys:String>
    <sys:String x:Key="LabelPresetName">Preset Name</sys:String>
    <sys:String x:Key="LabelSelectPreset">Select Preset</sys:String>
    <sys:String x:Key="TitleCreatePlatform">Create Platform</sys:String>
    <sys:String x:Key="TitleEditPlatform">Edit Platform</sys:String>
    <sys:String x:Key="TitleCreatePreset">Create Preset</sys:String>
    <sys:String x:Key="TitleEditPreset">Edit Preset</sys:String>
    <sys:String x:Key="BtnEdit">Edit</sys:String>
    <sys:String x:Key="PlaceholderResolution">e.g. 1920x1080</sys:String>
    <sys:String x:Key="PlaceholderBitrate">e.g. 5000</sys:String>
    <sys:String x:Key="PlaceholderFPS">e.g. 60</sys:String>
    <sys:String x:Key="PlaceholderCodec">e.g. libx264</sys:String>
    <sys:String x:Key="PlaceholderFormat">e.g. .mp4</sys:String>
    <sys:String x:Key="LabelFFmpegStatusPrefix">FFmpeg Status:</sys:String>
    <sys:String x:Key="FFmpegAvailable">Available</sys:String>
    <sys:String x:Key="FFmpegNotFound">Not Found</sys:String>
    <sys:String x:Key="FFmpegNotFoundInPath">FFmpeg not found in system PATH</sys:String>
    <sys:String x:Key="StatusError">Error</sys:String>
    <sys:String x:Key="StatusErrorCreatingDirectory">Error creating directory</sys:String>
    <sys:String x:Key="StatusPendingInQueue">Pending in queue...</sys:String>
    <sys:String x:Key="StatusProcessing">Processing...</sys:String>
    <sys:String x:Key="StatusProcessingPrefix">Processing</sys:String>
    <sys:String x:Key="AuthLoginPasswordRequired">Login and password are required.</sys:String>
    <sys:String x:Key="AuthUserAlreadyExists">User already exists.</sys:String>
    <sys:String x:Key="AuthRegistrationSuccessful">Registration successful.</sys:String>
    <sys:String x:Key="AuthInvalidLoginOrPassword">Invalid login or password.</sys:String>
    <sys:String x:Key="AuthLoginSuccessful">Login successful.</sys:String>
    <sys:String x:Key="DialogSelectSourceVideo">Select Source Video</sys:String>
    <sys:String x:Key="DialogVideoFiles">Video files</sys:String>
    <sys:String x:Key="DialogSelectDestinationFolder">Select Destination Folder</sys:String>
    <sys:String x:Key="DialogSelectDefaultProjectsFolder">Select Default Projects Folder</sys:String>
    <sys:String x:Key="LogProject">Project</sys:String>
    <sys:String x:Key="LogCreated">Created</sys:String>
    <sys:String x:Key="LogSource">Source</sys:String>
</ResourceDictionary>
