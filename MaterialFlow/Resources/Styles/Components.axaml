<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Expressive: Filled Button (Primary Action) -->
    <ControlTheme x:Key="FilledButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.80"/>
        </Style>
    </ControlTheme>

    <!-- Expressive: Primary Action Button (Solid color) -->
    <ControlTheme x:Key="PrimaryActionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Opacity" Value="0.90"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.80"/>
        </Style>
    </ControlTheme>

    <!-- Expressive: Tonal Button (Secondary) -->
    <ControlTheme x:Key="TonalButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
    </ControlTheme>

    <!-- Expressive: Outlined Button -->
    <ControlTheme x:Key="OutlinedButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Expressive: Elevated Card -->
    <ControlTheme x:Key="ElevatedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </ControlTheme>

    <!-- Expressive: Filled Card -->
    <ControlTheme x:Key="FilledCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </ControlTheme>

    <!-- Expressive: Navigation Drawer Item -->
    <ControlTheme x:Key="SidebarNavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Height="{TemplateBinding Height}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ControlTheme>

    <!-- Expressive: Search Bar TextBox -->
    <ControlTheme x:Key="SearchBar" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <TextPresenter x:Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   VerticalAlignment="Center"/>
                    <TextBlock x:Name="PART_Watermark"
                               Text="{TemplateBinding Watermark}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
